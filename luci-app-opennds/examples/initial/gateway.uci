# UCI batch input for an installed luci-app-opennds instance.
# Select gatewayinterface with select-interface.sh and back up the current config.
# See README.md for the complete application sequence.
set opennds.setup.enabled='1'
set opennds.setup.gatewayname='访客 Wi-Fi'
set opennds.setup.gatewayport='2050'
set opennds.setup.gatewayfqdn='status.client'
set opennds.setup.fwhook_enabled='1'
set opennds.setup.allow_preemptive_authentication='1'
set opennds.setup.login_option_enabled='3'
set opennds.setup.themespec_path='/usr/lib/opennds/theme_luci.sh'
set opennds.setup.statuspath='/usr/lib/opennds/status_luci.sh'
set opennds.setup.fasport='443'
set opennds.setup.maxclients='50'
set opennds.setup.sessiontimeout='120'
set opennds.setup.authidletimeout='15'
set opennds.setup.preauthidletimeout='5'
set opennds.setup.checkinterval='15'
set opennds.setup.downloadrate='0'
set opennds.setup.uploadrate='0'
set opennds.setup.downloadquota='0'
set opennds.setup.uploadquota='0'
set opennds.setup.ratecheckwindow='2'
set opennds.setup.max_page_size='16384'
set opennds.setup.debuglevel='1'
commit opennds
