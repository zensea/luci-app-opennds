msgid "Remote resource refresh interval (minutes)"
msgstr ""

msgid "Empty or 0 disables periodic refresh. This applies to downloaded resources used by native themes."
msgstr ""

msgid "Local authentication log mountpoint"
msgstr ""

msgid "Empty uses /tmp. Select an existing writable RAM or external-storage mountpoint; avoid internal flash. This setting does not change syslog."
msgstr ""

msgid "Maximum local authentication log entries"
msgstr ""

msgid "Empty uses 100 entries. 0 disables log rotation; ensure sufficient storage."
msgstr ""

msgid "DHCP leases file"
msgstr ""

msgid "Empty searches the native default lease files. Use an existing readable file for a custom dnsmasq instance."
msgstr ""

msgid "Fast client interface scan"
msgstr ""

msgid "Empty inherits enabled. Disable to search actual wireless interfaces; extended or mesh networks may scan more slowly."
msgstr ""

