msgstr ""

msgid "Plugin branded status page"
msgstr ""

msgid "Maximum portal page size (bytes)"
msgstr ""

msgid "Minimum 1024 bytes. Empty uses 10240. Larger pages consume more router memory; Portal Studio still checks its content against this limit."
msgstr ""

msgid "Custom FAS parameters"
msgstr ""

msgid "Use name=value; encode spaces as %20 and single quotes as %27."
msgstr ""

msgid "Custom ThemeSpec variables"
msgstr ""

msgid "Use name=value or input=phone:Phone%20number:tel;email:Email:email. Values are native definitions, not shell commands."
