# UCI batch input for an installed luci-app-opennds instance.
# Select gatewayinterface with select-interface.sh and back up the current config.
# See README.md for the complete application sequence.
set opennds.@opennds[0].enabled='1'
set opennds.@opennds[0].gatewayname='访客 Wi-Fi'
set opennds.@opennds[0].gatewayport='2050'
set opennds.@opennds[0].gatewayfqdn='status.client'
set opennds.@opennds[0].fwhook_enabled='1'
set opennds.@opennds[0].allow_preemptive_authentication='1'
set opennds.@opennds[0].login_option_enabled='3'
set opennds.@opennds[0].themespec_path='/usr/lib/opennds/theme_luci.sh'
# Set fasport for the installed daemon version before applying this batch.
set opennds.@opennds[0].maxclients='50'
set opennds.@opennds[0].sessiontimeout='120'
set opennds.@opennds[0].authidletimeout='15'
set opennds.@opennds[0].preauthidletimeout='5'
set opennds.@opennds[0].checkinterval='15'
set opennds.@opennds[0].downloadrate='0'
set opennds.@opennds[0].uploadrate='0'
set opennds.@opennds[0].downloadquota='0'
set opennds.@opennds[0].uploadquota='0'
set opennds.@opennds[0].ratecheckwindow='2'
set opennds.@opennds[0].max_page_size='16384'
set opennds.@opennds[0].debuglevel='1'
commit opennds
