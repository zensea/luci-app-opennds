msgstr "近期系统日志 (openNDS Syslog)"

msgid "openNDS Portal ThemeSpec Studio"
msgstr "openNDS Portal 门户实时设计器 (ThemeSpec Studio)"

msgid "Customize portal branding and copy with real-time preview. Saving switches openNDS to ThemeSpec mode."
msgstr "定制点击放行门户的外观与文案，右侧预览效果。保存后将切换到本插件的 ThemeSpec 点击放行模式，替换当前认证模式。"

msgid "Branding & Content"
msgstr "门户品牌与文字定制"

msgid "Portal Title"
msgstr "门户主标题 (Title)"

msgid "Welcome Subtitle / Notice"
msgstr "欢迎副标题 / 提示"

