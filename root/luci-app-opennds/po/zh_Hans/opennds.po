msgstr "品牌 Logo 样式"

msgid "Classic Wi-Fi Icon"
msgstr "经典无线网络图标 (Wi-Fi)"

msgid "Cafe / Restaurant (Coffee)"
msgstr "咖啡厅 / 餐饮休闲 (Coffee)"

msgid "Hotel / Hospitality"
msgstr "酒店 / 宾馆客房 (Hotel)"

msgid "Office / Conference (Business)"
msgstr "商务办公 / 会议中心 (Business)"

msgid "Primary Accent Color"
msgstr "主题主色调 (Primary Accent)"

msgid "Button Label"
msgstr "认证按钮文案"

msgid "Terms of Service (ToS)"
msgstr "免责声明与上网条款 (ToS)"

msgid "Title and button text cannot be empty."
msgstr "标题和按钮文案不能为空。"

msgid "Generating ThemeSpec Template"
msgstr "正在生成 ThemeSpec 模板"

msgid "Saving theme configuration, updating gateway name and restarting openNDS..."
msgstr "正在保存设计配置，同步网关名称并重启 openNDS..."

msgid "Failed to save portal configuration."
msgstr "保存门户失败。"

msgid "Failed to load portal configuration."
msgstr "读取门户配置失败。"

msgid "Portal configuration saved and restarted. Verify daemon status in Overview."
msgstr "门户配置已保存，重启指令已执行。请在运行总览确认网关状态。"

msgid "Save & Generate Portal"
msgstr "保存并生成门户模板"

msgid "Cancel"
msgstr "取消"

msgid "Done"
msgstr "完成"

msgid "I have read and agree to the Terms of Service"
msgstr "已阅读并同意上网安全服务协议"

msgid "Preview click action. Test real authentication using a client device."
msgstr "预览点击效果；真实认证请使用访客终端连接网关测试。"

msgid "Mobile Viewport Simulator"
msgstr "手机端仿真视口 (可直接点击体验认证)"

msgid "Footer Notice / Copyright"
msgstr "底部版权 / 提示信息"

msgid "Upgrade configuration file"
msgstr "升级配置文件"

msgid "Upgrading openNDS configuration"
msgstr "正在升级 openNDS 配置"

msgid "Backing up the configuration, applying supported changes and restarting openNDS..."
msgstr "正在备份配置、应用支持的升级并重启 openNDS..."

msgid "Configuration backup: "
msgstr "配置备份："

msgid "Configuration upgrade failed."
msgstr "配置升级失败。"

msgid "Configuration upgraded. Check daemon status and test portal authentication."
msgstr "配置已升级。请检查网关运行状态并测试门户认证。"

msgid "The configuration is incompatible with the installed openNDS version. Upgrade it to preserve existing settings and create a backup."
msgstr "检测到配置与已安装的 openNDS 版本不兼容。升级时将备份原文件并保留现有设置。"

msgid "Unable to check openNDS configuration."
msgstr "无法检查 openNDS 配置。"

msgid "Upgrade the configuration file from Overview before editing gateway settings."
msgstr "请先在运行总览升级配置文件，再编辑网关设置。"

msgid "For openNDS v11, select a local authentication mode instead of setting FAS port to 0."
msgstr "openNDS v11 请直接选择本地认证模式，不要将 FAS 端口设为 0。"
