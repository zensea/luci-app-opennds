msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "openNDS Captive Portal"
msgstr "openNDS 认证门户"

msgid "Overview & Clients"
msgstr "运行总览 & 终端"

msgid "Gateway Settings"
msgstr "网关参数设置"

msgid "Portal Studio"
msgstr "Portal 界面设计器"

msgid "openNDS Gateway Configuration"
msgstr "openNDS 认证网关配置"

msgid "Configure network interfaces, authentication policies, FAS, rate limits, and access controls for openNDS."
msgstr "配置 openNDS 绑定的网络接口、认证模式、FAS 远端鉴权、流量限速以及访问控制名单。"

msgid "Gateway & Authentication Parameters"
msgstr "网关与认证参数"

msgid "General Settings"
msgstr "基本设置"

msgid "Authentication & FAS"
msgstr "认证策略 & FAS"

msgid "Traffic Control & Quotas"
msgstr "限速与配额"

msgid "Access Control & Walled Garden"
msgstr "白名单与围墙花园"

msgid "Enable openNDS daemon"
msgstr "启用 openNDS 守护进程"

msgid "Controls whether the daemon is allowed to run. Service autostart can be configured in System → Startup."
msgstr "控制守护进程是否允许运行（官方默认启用）。开机自启请在“系统 → 启动项”设置。"

msgid "Firewall reload hook (fwhook_enabled)"
msgstr "防火墙重载联动 (fwhook_enabled)"

msgid "Re-inject openNDS rules when OpenWrt firewall (FW4/nftables) restarts. Required to prevent rule loss."
msgstr "当 OpenWrt 防火墙 (FW4 / nftables) 重启时，通知 openNDS 自动重载并重新注入规则链 (必须开启以防规则丢失)。"

msgid "Allow preemptive authentication (allow_preemptive_authentication)"
msgstr "允许抢先/重连认证 (allow_preemptive_authentication)"

msgid "Allow ndsctl to authorize connected clients that have not yet entered the preauth state."
msgstr "允许 ndsctl 工具优先授权已连接但未进入 preauth 状态的终端（默认用于重启后自动恢复已认证客户端会话及 IoT 设备）。"

msgid "Gateway interface (gatewayinterface)"
msgstr "网关监听网络接口 (gatewayinterface)"

msgid "Network interface where openNDS listens and intercepts HTTP traffic (default is br-lan)."
msgstr "选择 openNDS 监听并拦截 HTTP 流量的网络接口 (官方默认为 br-lan，若配置有独立访客网络可指定为 br-guest)。"

msgid "Gateway name (gatewayname)"
msgstr "热点门户名称 (gatewayname)"

msgid "Hotspot/venue name displayed on the portal authentication page (default is openNDS)."
msgstr "显示在用户认证界面上的 WiFi 热点/场所名称 (官方默认为 openNDS)。"

msgid "Name cannot contain line breaks or single quotes. Use &#39; for single quotes."
msgstr "名称不能包含换行或单引号，请用 &#39; 表示单引号。"

msgid "Gateway web server port (gatewayport)"
msgstr "内置 Web 服务端口 (gatewayport)"

msgid "Port for openNDS embedded web server, default 2050 (port 80 is prohibited)."
msgstr "openNDS 内置微型 Web 服务器的端口，默认为 2050 (禁止使用 80 端口)。"

msgid "Gateway port cannot be 80."
msgstr "openNDS 网关端口不能使用 80。"

msgid "Gateway FQDN (gatewayfqdn)"
msgstr "虚拟重定向域名 (gatewayfqdn)"

msgid "Virtual domain used by clients to access the portal (default status.client)."
msgstr "终端用于解析和访问认证门户的虚拟域名（配合 DNS 劫持生效，默认为 status.client）。"

msgid "Maximum client capacity (maxclients)"
msgstr "最大并发客户端容量 (maxclients)"

msgid "Maximum concurrent connected clients allowed before queuing new connections."
msgstr "达到此连接上限后，新接入的终端将收到满载排队提示。"

msgid "Check interval (seconds)"
msgstr "客户端租期检测周期 (秒)"

msgid "Interval for polling client timeouts and quota consumption."
msgstr "定时轮询检测客户端空闲超时和配额消耗的时间间隔。"

msgid "Debug log level (debuglevel)"
msgstr "调试日志等级 (debuglevel)"

msgid "0 - Silent (errors only)"
msgstr "0 - 静默模式 (仅严重错误)"

msgid "1 - Normal notices (default)"
msgstr "1 - 标准操作通知 (官方默认)"

msgid "2 - Detailed status (INFO)"
msgstr "2 - 详细状态调试 (INFO)"

msgid "3 - Full trace (DEBUG)"
msgstr "3 - 全量网络跟踪 (DEBUG)"

msgid "Authentication policy (login_option_enabled)"
msgstr "认证策略方案 (login_option_enabled)"

msgid "Specify the authentication workflow: Click to Continue, User Login, FAS, or Custom ThemeSpec."
msgstr "指定 openNDS 的鉴权工作流，包含点击直连、登记登录、外部 FAS 转发鉴权以及自定义 ThemeSpec。"

msgid "1. Dynamic Click to Continue"
msgstr "1. 动态点击放行 (Dynamic Click to Continue)"

msgid "2. Username / Email Login"
msgstr "2. 用户名 / 邮箱登记登录 (User / Email Login)"

msgid "3. External FAS server"
msgstr "3. 外部 FAS 服务器"

msgid "4. Custom ThemeSpec script"
msgstr "4. 自定义 ThemeSpec 脚本 (Custom ThemeSpec)"

msgid "Remote FAS FQDN (fasremotefqdn)"
msgstr "FAS 远程服务器域名 (fasremotefqdn)"

msgid "Fully qualified domain name of remote FAS server, without http:// or https:// prefix."
msgstr "远程 FAS 认证服务器的完全限定域名 (FQDN)，请勿包含 http:// 或 https:// 前缀。"

msgid "Remote FAS IP (fasremoteip)"
msgstr "FAS 远程服务器 IP (fasremoteip)"

msgid "IPv4 address of remote FAS server. Defaults to gateway IP if unset."
msgstr "远程 FAS 服务器的 IPv4 地址。留空时使用本地网关地址；远程域名的 DNS 解析结果须与此地址一致。"

msgid "FAS port (fasport)"
msgstr "FAS 服务端口 (fasport)"

msgid "Port on which FAS server listens (typically 80 or 443)."
msgstr "FAS 服务器监听的 Web 服务端口（通常为 80 或 443）。"

msgid "FAS path (faspath)"
msgstr "FAS 接口路径 (faspath)"

msgid "Path from FAS web root to login script."
msgstr "从 FAS Web 根目录到登录页面的相对路径。"

msgid "Path must start with / and contain no spaces."
msgstr "路径必须以 / 开头且不能包含空白字符。"

msgid "FAS security level (fas_secure_enabled)"
msgstr "FAS 安全认证等级 (fas_secure_enabled)"

msgid "FAS protocol and token security level. Levels 3 and 4 enforce HTTPS and authmon."
msgstr "控制 FAS 协议与令牌保护机制。等级 3 与 4 强制使用 HTTPS 并启用 authmon 反向穿透守护进程。"

msgid "0 - Plaintext HTTP (insecure, testing only)"
msgstr "0 - 明文 HTTP 传输 (测试环境，极不安全)"

msgid "1 - Basic SHA256 hash token (HTTP)"
msgstr "1 - 基础 SHA256 哈希 Token (HTTP)"

msgid "2 - AES-256-CBC encryption (HTTP, requires php-openssl)"
msgstr "2 - AES-256-CBC 密码加密 (HTTP，需 php-openssl)"

msgid "3 - AES-256-CBC + HTTPS + authmon (recommended for production)"
msgstr "3 - AES-256-CBC 加密 + HTTPS + authmon 穿透 (推荐生产)"

msgid "4 - SHA256 hash token + HTTPS + authmon"
msgstr "4 - SHA256 哈希 Token + HTTPS + authmon 穿透"

msgid "FAS pre-shared key (faskey)"
msgstr "FAS 预共享密钥 (faskey)"

msgid "Pre-shared key between openNDS and FAS for encryption and signature validation."
msgstr "openNDS 与外部 FAS 之间用于数据加密或签名校验的双向密钥（不能包含空格）。"

msgid "Key cannot contain whitespace."
msgstr "密钥不能包含空白字符。"

msgid "ThemeSpec script path (themespec_path)"
msgstr "ThemeSpec 模板脚本路径 (themespec_path)"

msgid "Absolute path to custom ThemeSpec script (default is /usr/lib/opennds/theme_click-to-continue-basic.sh)."
msgstr "自定义 ThemeSpec 页面生成脚本的绝对路径 (官方预置 basic 模板位于 /usr/lib/opennds/theme_click-to-continue-basic.sh)。"

msgid "Session timeout (minutes)"
msgstr "单次认证会话时长 (分钟)"

msgid "Client session timeout before requiring re-authentication. 0 means unlimited (default 1440 min)."
msgstr "超过此时间后终端需重新弹出 Portal 进行认证。填 0 表示永久有效 (官方默认 1440 分钟/24小时)。"

msgid "Authenticated idle timeout (minutes)"
msgstr "认证终端空闲超时断开 (分钟)"

msgid "Idle timeout before disconnecting inactive authenticated clients (default 120 min)."
msgstr "终端在此时间内无任何网络流量交互时，自动释放连接并踢下线 (官方默认 120 分钟)。"

msgid "Preauthenticated idle timeout (minutes)"
msgstr "待认证状态超时放弃 (分钟)"

msgid "Timeout for clients in preauth state before dropping connection (default 30 min)."
msgstr "终端连接 Wi-Fi 后在此时间内未完成登录认证，自动断开连接 (官方默认 30 分钟)。"

msgid "Download rate limit (downloadrate - kb/s)"
msgstr "单终端最大下行速率 (downloadrate - kb/s)"

msgid "Client download rate limit calculated over rate check window, 0 for unlimited."
msgstr "基于滑动平均窗口计算的单客户端下行速率限制，0 为不限速。"

msgid "Upload rate limit (uploadrate - kb/s)"
msgstr "单终端最大上行速率 (uploadrate - kb/s)"

msgid "Client upload rate limit calculated over rate check window, 0 for unlimited."
msgstr "基于滑动平均窗口计算的单客户端上行速率限制，0 为不限速。"

msgid "Rate check window (ratecheckwindow)"
msgstr "速率检测滑动窗口周期 (ratecheckwindow)"

msgid "Window multiplier for average rate calculation (duration = checkinterval * ratecheckwindow). Set 0 to disable."
msgstr "计算速率平均值的滑动采样窗口乘数，默认为 2（窗口时长为 checkinterval * ratecheckwindow）。若设为 0 则全局禁用限速。"

msgid "Download quota (downloadquota - kB)"
msgstr "单终端最大下载流量配额 (downloadquota - kB)"

msgid "Client download quota limit before requiring re-authentication, 0 for unlimited."
msgstr "达到限制后自动将客户端踢下线并要求重新认证，0 为无限制。"

msgid "Upload quota (uploadquota - kB)"
msgstr "单终端最大上传流量配额 (uploadquota - kB)"

msgid "Client upload quota limit before requiring re-authentication, 0 for unlimited."
msgstr "达到限制后自动将客户端踢下线并要求重新认证，0 为无限制。"

msgid "Trusted MAC whitelist (trustedmac)"
msgstr "永久免认证 MAC 白名单 (trustedmac)"

msgid "Clients matching these MAC addresses bypass portal authentication entirely."
msgstr "此列表中的终端 MAC 地址将直接绕过 Captive Portal 认证获得完全互联网权限（如网络打印机、POS 机、收银台等）。"

msgid "Choose a discovered device by name, MAC or IP address, or enter a MAC address manually."
msgstr "可按主机名、MAC 或 IP 地址选择已发现的设备，也可手动输入 MAC 地址。"

msgid "Failed to read discovered devices; enter MAC addresses manually or reload the page."
msgstr "读取已发现的设备失败，可手动输入 MAC 地址或刷新页面重试。"

msgid "Walled garden FQDN list (walledgarden_fqdn_list)"
msgstr "围墙花园放行域名 (walledgarden_fqdn_list)"

msgid "Domains accessible to preauthenticated clients before logging in."
msgstr "未认证的访客在登录前即可直接访问这些域名（例如微信/支付宝免登收银台、Apple CNA 探针、Android 门户探针等）。"

msgid "Walled garden port list (walledgarden_port_list)"
msgstr "围墙花园放行端口 (walledgarden_port_list)"

msgid "Allowed ports for walled garden domains (typically 443; empty allows all ports)."
msgstr "放行给未认证用户的外部端口（推荐指定 443 避免干扰 80 端口 CPD 探针；若留空则对上述 FQDN 放行全部端口）。"

msgid "Blocked FQDN list (blocklist_fqdn_list)"
msgstr "认证用户域名黑名单 (blocklist_fqdn_list)"

msgid "Domains blocked even for authenticated clients."
msgstr "即使已通过认证的访客终端也禁止访问的外部域名列表。"

msgid "Blocked port list (blocklist_port_list)"
msgstr "阻止列表端口 (blocklist_port_list)"

msgid "Ports blocked for blocklist domains (empty blocks all ports)."
msgstr "针对黑名单域名限制的端口（若留空则阻止上述 FQDN 的所有端口访问）。"

msgid "Operation failed without a valid response."
msgstr "操作失败，未收到成功响应。"

msgid "Failed to read log"
msgstr "读取日志失败"

msgid "openNDS Overview & Client Management"
msgstr "openNDS 认证门户运行总览 & 终端管理"

msgid "Monitor daemon status, interface parameters, and manage connected clients in real time."
msgstr "实时监控 openNDS 守护进程状态、接口运行参数，并对当前已连接的访客终端进行即时放行或踢除控制。"

