#!/bin/sh

# opennds owns this file. Never replace its configuration or generated faskey.
if [ ! -s /etc/config/opennds ]; then
	printf 'config opennds\n' > /etc/config/opennds || exit 1
fi

# ThemeSpec files must be executable, including when installed from a Windows checkout.
chmod 0755 /usr/lib/opennds/theme_luci.sh /usr/libexec/luci-opennds-restart 2>/dev/null || true

# LuCI 24.10+ consumes the shipped JSON trigger; 23.05 uses /etc/config/ucitrack.
# An init=opennds entry is ignored because opennds uses procd. Use a non-init
# executable so ucitrack registers a real config.change trigger on both versions.
if ! grep -q '/usr/share/ucitrack/' /etc/init.d/ucitrack 2>/dev/null; then
	uci -q get ucitrack.@opennds[0] >/dev/null || uci -q add ucitrack opennds >/dev/null || exit 1
	custom_exec=$(uci -q get ucitrack.@opennds[0].exec)
	custom_init=$(uci -q get ucitrack.@opennds[0].init)
	if [ -z "$custom_exec" ] && { [ -z "$custom_init" ] || [ "$custom_init" = opennds ]; }; then
		uci -q delete ucitrack.@opennds[0].init >/dev/null 2>&1
		uci set ucitrack.@opennds[0].exec='/usr/libexec/luci-opennds-restart' || exit 1
		uci commit ucitrack || exit 1
	fi
fi
[ ! -x /etc/init.d/ucitrack ] || /etc/init.d/ucitrack reload >/dev/null 2>&1 || exit 1

# Rebuild LuCI menu & rpcd ACL cache
/etc/init.d/rpcd reload >/dev/null 2>&1

exit 0
